{
  "agentId": "my-agent",
  "agentName": "My Agent",
  "dataPath": "/path/to/CCManagerData",
  "allowedPaths": ["/Users/me/projects/*"],
  "blockedPaths": ["/Users/me/.ssh"],
  "capabilities": ["no-gpu"],
  "xaiApiKey": "xai-your-api-key",
  "xaiBaseUrl": "https://api.x.ai",
  "xaiDefaultModel": "grok-4.6",
  "dockerConfig": {
    "image": "ccmanager-runner:latest",
    "memory": "8g",
    "cpus": "4",
    "network": "bridge",
    "sessionsDir": "/home/me/.ccm-sessions",
    "extraMounts": [
      {
        "source": "/data/datasets",
        "target": "/datasets",
        "readonly": true
      }
    ]
  }
}
